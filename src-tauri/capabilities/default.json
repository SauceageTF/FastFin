{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and its HUD overlay window",
  "windows": ["main", "hud"],
  "permissions": [
    "core:default",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/mpv", "sidecar": true }]
    }
  ]
}
